#!/bin/bash
# ─────────────────────────────────────────────────────────────────────────────
#  AppRun de l'AppImage Rufus — fait de l'AppImage un VÉRITABLE installeur.
#
#  Au premier lancement (double-clic sur Rufus.AppImage), propose d'« installer »
#  Rufus sur le poste : copie l'AppImage dans ~/.local/bin et crée un raccourci
#  dans le menu d'Ubuntu (fichier .desktop + icône), comme un setup.exe / .dmg.
#  Les lancements suivants (depuis le menu) démarrent directement l'application.
#
#  Désactivable en exportant RUFUS_NO_INSTALL=1.
# ─────────────────────────────────────────────────────────────────────────────
HERE="$(dirname "$(readlink -f "${0}")")"

# Bibliothèques + plugins Qt embarqués par linuxdeployqt.
export LD_LIBRARY_PATH="${HERE}/usr/lib:${LD_LIBRARY_PATH}"
export QT_PLUGIN_PATH="${HERE}/usr/plugins:${QT_PLUGIN_PATH}"
export QT_QPA_PLATFORM_PLUGIN_PATH="${HERE}/usr/plugins/platforms"

APPNAME="Rufus"
BIN="${HERE}/usr/bin/Rufus"                       # binaire réel dans l'AppDir
ICON_SRC="${HERE}/usr/share/icons/hicolor/256x256/apps/rufus.png"

APPS_DIR="${HOME}/.local/share/applications"
ICONS_DIR="${HOME}/.local/share/icons/hicolor/256x256/apps"
BIN_DIR="${HOME}/.local/bin"
DESKTOP="${APPS_DIR}/rufus.desktop"

integration_proposee() {
    # Déjà installé, ou demande explicite de ne rien faire, ou pas d'affichage
    # graphique (lancement en ligne de commande) → on ne propose rien.
    [ -n "${RUFUS_NO_INSTALL}" ] && return 1
    [ -f "${DESKTOP}" ]         && return 1
    [ -z "${DISPLAY}${WAYLAND_DISPLAY}" ] && return 1
    # $APPIMAGE est posé par le runtime AppImage et pointe sur le fichier lui-même.
    [ -z "${APPIMAGE}" ]        && return 1
    return 0
}

installer() {
    mkdir -p "${APPS_DIR}" "${ICONS_DIR}" "${BIN_DIR}"

    # 1. Copie de l'AppImage dans ~/.local/bin
    local cible="${BIN_DIR}/${APPNAME}.AppImage"
    cp -f "${APPIMAGE}" "${cible}"
    chmod +x "${cible}"

    # 2. Icône
    [ -f "${ICON_SRC}" ] && cp -f "${ICON_SRC}" "${ICONS_DIR}/rufus.png"

    # 3. Raccourci menu (.desktop) pointant sur l'AppImage installée
    cat > "${DESKTOP}" <<EOF
[Desktop Entry]
Type=Application
Name=${APPNAME}
Exec=${cible}
Icon=rufus
Comment=Logiciel de gestion de cabinet d'Ophtalmologie
Categories=Office;MedicalSoftware;
Terminal=false
EOF
    chmod +x "${DESKTOP}"

    # 4. Rafraîchissement des caches (best-effort, sans bloquer)
    command -v update-desktop-database >/dev/null 2>&1 && \
        update-desktop-database "${APPS_DIR}" >/dev/null 2>&1
    command -v gtk-update-icon-cache >/dev/null 2>&1 && \
        gtk-update-icon-cache -f -t "${HOME}/.local/share/icons/hicolor" >/dev/null 2>&1
}

if integration_proposee; then
    REPONSE=1   # par défaut : on installe (si pas de zenity pour demander)
    if command -v zenity >/dev/null 2>&1; then
        zenity --question --no-wrap --title="Installer Rufus" \
            --text="Voulez-vous ajouter Rufus au menu des applications de cet ordinateur ?" \
            2>/dev/null
        REPONSE=$?
    fi
    if [ "${REPONSE}" -eq 0 ]; then
        installer
        command -v zenity >/dev/null 2>&1 && zenity --info --no-wrap \
            --title="Rufus installé" \
            --text="Rufus a été ajouté au menu des applications.\nVous pouvez désormais le lancer depuis le menu d'Ubuntu." 2>/dev/null
    fi
fi

exec "${BIN}" "$@"
