# ── 1. Configuration système du poste (composants requis) ─────────────────────
#  Composants que l'AppImage ne peut PAS embarquer proprement : polices (dont les
#  MS core fonts), plugins GStreamer (lecture vidéo), client MySQL (sauvegarde/
#  restauration), et appartenance au groupe « dialout » (appareils de mesure sur
#  port série). Installés via UN seul pkexec (apt), à l'installation, avec
#  consentement.
#  Plus de marqueur « .systeme_ok » : tant que le poste n'est pas installé (pas de
#  .desktop), on rejoue toute la séquence. Si la config ÉCHOUE vraiment, on s'arrête
#  et on explique pourquoi ; la trace détaillée va dans ~/.rufus/install-systeme.log.
#  NB : libfuse2 (requis pour LANCER l'AppImage) ne peut pas s'auto-installer ici
#  (œuf/poule) → c'est un prérequis documenté sur la page de téléchargement.
#  Retour : 0 = OK (ou non applicable : pas de GUI / distribution non-apt) ; 1 = échec → on stoppe.
configurer_systeme() {
    [ -n "${RUFUS_NO_INSTALL}" ]          && return 0
    [ -z "${DISPLAY}${WAYLAND_DISPLAY}" ] && return 0   # pas d'affichage graphique
    command -v zenity  >/dev/null 2>&1    || return 0   # pas d'UI pour demander
    command -v apt-get >/dev/null 2>&1    || return 0   # distribution non-apt : on ne touche à rien

    # MAJ / réinstallation : si tout est déjà en place, on ne repropose rien.
    if composants_systeme_presents; then
        ecrit_certif "Composants système déjà présents — configuration ignorée"
        return 0
    fi

    zenity --question --no-wrap --title="${MSG_CFG_TITLE}" \
        --text="${MSG_CFG_BODY}" \
        --ok-label="${MSG_CFG_OK}" --cancel-label="${MSG_CFG_CANCEL}" 2>/dev/null || {
            zenity --error --no-wrap --title="${MSG_CANCEL_TITLE}" \
                --text="${MSG_CANCEL_BODY}" 2>/dev/null
            return 1
        }

    local user; user="$(id -un)"
    local LOG="${RUFUS_DIR}/install-systeme.log"
    mkdir -p "${RUFUS_DIR}" 2>/dev/null

    if ! command -v pkexec >/dev/null 2>&1; then
        zenity --warning --no-wrap --title="${MSG_PKEXEC_TITLE}" \
            --text="${MSG_PKEXEC_LEAD}\n\nsudo apt install ${PAQUETS_REQUIS}\nsudo usermod -aG dialout ${user}\n\n${MSG_PKEXEC_TAIL}" 2>/dev/null
        return 1
    fi

    # Un SEUL pkexec : EULA mscorefonts pré-acceptée, apt update, install PAQUET PAR
    # PAQUET (un paquet absent n'interrompt pas le reste), puis ajout au groupe dialout.
    # L'utilisateur réel est passé via env (pkexec s'exécute en root, $USER y vaudrait root).
    # DPkg::Lock::Timeout=300 : si unattended-upgrades tient le verrou apt (fréquent sur un
    # système fraîchement installé), apt patiente proprement jusqu'à 5 min au lieu de figer.
    # Le code de sortie porte le diagnostic : 10 = pas d'accès aux dépôts (réseau) ; pkexec
    # ajoute 126 (auth annulée) / 127 (non autorisé). La sortie complète est tee-ée dans LOG.
    # (NB : aucun commentaire à apostrophe DANS le bloc bash -c '...' — ça casserait la quote.)
    pkexec env DEBIAN_FRONTEND=noninteractive RUFUS_USER="${user}" RUFUS_PAQUETS="${PAQUETS_REQUIS}" bash -c '
        trap "" PIPE
        echo "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true" | debconf-set-selections 2>/dev/null
        rc=0
        if ! apt-get -o DPkg::Lock::Timeout=300 update -y; then
            echo "RUFUS_ERR: echec de apt-get update (acces reseau aux depots indisponible)"
            rc=10
        fi
        for p in $RUFUS_PAQUETS ; do
            apt-get -o DPkg::Lock::Timeout=300 install -y "$p" || echo "RUFUS_ERR: paquet non installe: $p"
        done
        usermod -aG dialout "$RUFUS_USER" || echo "RUFUS_ERR: ajout au groupe dialout impossible"
        exit $rc
    ' 2>&1 | tee "${LOG}" | sed -u 's/^/# /' | zenity --progress --pulsate --no-cancel --auto-close \
        --title="${MSG_PROG_TITLE}" \
        --text="${MSG_PROG_TEXT}" 2>/dev/null
    local rc=${PIPESTATUS[0]}

    if [ "${rc}" -eq 0 ]; then
        ecrit_certif "Config système OK (polices, GStreamer, mysql-client, dialout) pour ${user}"
        return 0
    fi

    # Échec réel : on explique (si on peut) et on stoppe l'installation.
    local raison
    case "${rc}" in
        126) raison="${MSG_REASON_126}" ;;
        127) raison="${MSG_REASON_127}" ;;
        10)  raison="${MSG_REASON_10}" ;;
        *)   raison="${MSG_REASON_DEF}" ;;
    esac
    ecrit_certif "Config système ÉCHEC (rc=${rc}) : ${raison}"
    zenity --error --no-wrap --title="${MSG_ERR_TITLE}" \
        --text="${MSG_ERR_LEAD}\n\n${raison}\n\n${MSG_ERR_DETAILS} ${LOG}" 2>/dev/null
    return 1
}

# Inscription de Rufus dans les MENUS (copie de l'AppImage + icône + .desktop).
# Démarche standard d'un installeur : on inscrit, on ne le demande pas.
inscrire_dans_menus() {
    mkdir -p "${APPS_DIR}" "${ICONS_DIR}" "${BIN_DIR}"

    # 1. Copie de l'AppImage dans ~/.local/bin
    local cible="${BIN_DIR}/${APPNAME}.AppImage"
    cp -f "${APPIMAGE}" "${cible}"
    chmod +x "${cible}"

    # 2. Icône
    [ -f "${ICON_SRC}" ] && cp -f "${ICON_SRC}" "${ICONS_DIR}/rufus.png"

    # 3. Raccourci menu (.desktop) pointant sur l'AppImage installée
    cat > "${DESKTOP}" <<EOF
[Desktop Entry]
Type=Application
Name=${APPNAME}
Exec=${cible}
Icon=rufus
Comment=Logiciel de gestion de cabinet d'Ophtalmologie
Categories=Office;MedicalSoftware;
Terminal=false
EOF
    chmod +x "${DESKTOP}"

    # 4. Rafraîchissement des caches (best-effort, sans bloquer)
    command -v update-desktop-database >/dev/null 2>&1 && \
        update-desktop-database "${APPS_DIR}" >/dev/null 2>&1
    command -v gtk-update-icon-cache >/dev/null 2>&1 && \
        gtk-update-icon-cache -f -t "${HOME}/.local/share/icons/hicolor" >/dev/null 2>&1
}

# Raccourci sur le BUREAU (copie du .desktop, marqué « de confiance » pour GNOME).
creer_raccourci_bureau() {
    local desk
    desk="$(xdg-user-dir DESKTOP 2>/dev/null)"
    [ -z "${desk}" ] && { [ -d "${HOME}/Bureau" ] && desk="${HOME}/Bureau" || desk="${HOME}/Desktop"; }
    mkdir -p "${desk}" 2>/dev/null
    cp -f "${DESKTOP}" "${desk}/rufus.desktop" 2>/dev/null || return 0
    chmod +x "${desk}/rufus.desktop" 2>/dev/null
    # GNOME ≥ 3.36 grise le lanceur tant qu'il n'est pas marqué « trusted ».
    command -v gio >/dev/null 2>&1 && gio set "${desk}/rufus.desktop" metadata::trusted true 2>/dev/null
}

# Épingler Rufus dans la barre des FAVORIS (Activités GNOME) via gsettings.
ajouter_aux_favoris() {
    command -v gsettings >/dev/null 2>&1 || return 0
    local cur
    cur="$(gsettings get org.gnome.shell favorite-apps 2>/dev/null)" || return 0
    case "${cur}" in *"'rufus.desktop'"*) return 0 ;; esac   # déjà épinglé
    local nouv
    case "${cur}" in
        "@as []"|"[]") nouv="['rufus.desktop']" ;;
        *)             nouv="${cur%]*}, 'rufus.desktop']" ;;
    esac
    gsettings set org.gnome.shell favorite-apps "${nouv}" 2>/dev/null
}

# ── Centrage des fenêtres de l'installation (GNOME) ───────────────────────────
# zenity n'a aucune option de position : ses fenêtres se placent où le gestionnaire
# de fenêtres veut (souvent décentrées). La parade fiable et sans dépendance : activer
# le temps de l'install le réglage GNOME « center-new-windows », puis RENDRE à
# l'utilisateur son réglage d'origine. No-op hors GNOME/mutter (clé absente).
CENTRAGE_ANCIEN=""
CENTRAGE_MODIFIE=0
activer_centrage_fenetres() {
    command -v gsettings >/dev/null 2>&1 || return 0
    CENTRAGE_ANCIEN="$(gsettings get org.gnome.mutter center-new-windows 2>/dev/null)" || return 0
    [ -z "${CENTRAGE_ANCIEN}" ] && return 0          # clé absente → pas GNOME/mutter, on ne touche à rien
    [ "${CENTRAGE_ANCIEN}" = "true" ] && return 0    # déjà centré → rien à changer ni à restaurer
    gsettings set org.gnome.mutter center-new-windows true 2>/dev/null && CENTRAGE_MODIFIE=1
}
restaurer_centrage_fenetres() {
    [ "${CENTRAGE_MODIFIE}" = "1" ] || return 0
    gsettings set org.gnome.mutter center-new-windows "${CENTRAGE_ANCIEN}" 2>/dev/null
    CENTRAGE_MODIFIE=0
}

# Inscription dans les menus SOUS animation : la copie de l'AppImage (~60 Mo) et le
# rafraîchissement des caches prennent plusieurs secondes pendant lesquelles, sinon,
# rien ne s'affiche (le fameux « trou » entre l'install des composants et la fenêtre
# finale). On enveloppe donc l'opération dans une barre pulsante.
inscrire_dans_menus_avec_animation() {
    if command -v zenity >/dev/null 2>&1; then
        ( inscrire_dans_menus ) 2>&1 | zenity --progress --pulsate --no-cancel --auto-close \
            --title="${MSG_FINAL_PROG_TITLE}" \
            --text="${MSG_FINAL_PROG_TEXT}" 2>/dev/null
    else
        inscrire_dans_menus
    fi
}

# Boîte finale : annonce l'installation réussie et propose, par cases à cocher,
# le raccourci bureau (précoché), les favoris (précoché) et le lancement (décoché).
proposer_raccourcis_et_lancement() {
    command -v zenity >/dev/null 2>&1 || { restaurer_centrage_fenetres; return 0; }   # pas d'UI : on s'arrête là, sans lancer

    local sel
    sel="$(zenity --list --checklist \
        --title="${MSG_DONE_TITLE}" --width=560 --height=300 \
        --text="${MSG_DONE_TEXT}" \
        --column="" --column="id" --column="Action" \
        --hide-column=2 --print-column=2 \
        TRUE  bureau  "${MSG_ACT_DESKTOP}" \
        TRUE  favoris "${MSG_ACT_FAV}" \
        FALSE lancer  "${MSG_ACT_RUN}" \
        2>/dev/null)"

    case "${sel}" in *bureau*)  creer_raccourci_bureau ;; esac
    case "${sel}" in *favoris*) ajouter_aux_favoris    ;; esac
    restaurer_centrage_fenetres   #! rendre son réglage à l'utilisateur AVANT le exec (qui ne reviendrait jamais)
    case "${sel}" in *lancer*)  exec "${BIN}" "$@"     ;; esac   # remplace le process : Rufus démarre
}

# Faut-il (re)jouer la séquence d'installation ? Oui tant que le poste n'est pas
# installé (pas de .desktop), qu'on n'a pas explicitement désactivé l'install, et
# qu'on tourne bien depuis l'AppImage avec un affichage graphique.
integration_proposee() {
    [ -n "${RUFUS_NO_INSTALL}" ]          && return 1
    [ -f "${DESKTOP}" ]                   && return 1   # déjà installé
    [ -z "${DISPLAY}${WAYLAND_DISPLAY}" ] && return 1   # lancement en ligne de commande
    [ -z "${APPIMAGE}" ]                  && return 1   # posé par le runtime AppImage
    return 0
}

# ── Séquence d'INSTALLATION (1er lancement de l'AppImage, poste pas encore installé) ──
if integration_proposee; then
    # 0. Centrer toutes les fenêtres de l'install (réglage rendu à l'utilisateur à la fin).
    activer_centrage_fenetres
    # 0 bis. 1re fenêtre : choix de la langue, puis chargement des textes correspondants.
    choisir_langue_install
    definir_textes
    # 1. Configurer le système. Si ça échoue réellement, on s'arrête là (rien d'inscrit).
    configurer_systeme || { restaurer_centrage_fenetres; exit 1; }
    # 2. Inscrire Rufus dans les menus (sous animation, pour ne pas laisser l'écran vide).
    inscrire_dans_menus_avec_animation
    # 3. Proposer raccourci bureau / favoris / lancement. Ne lance Rufus que si demandé.
    #    (restaure lui-même le centrage avant un éventuel exec.)
    proposer_raccourcis_et_lancement
    exit 0
fi

# ── Lancement NORMAL (poste déjà installé : démarrage depuis le menu) ──────────
exec "${BIN}" "$@"
