#!/bin/bash
# ─────────────────────────────────────────────────────────────────────────────
#  AppRun de l'AppImage Rufus — fait de l'AppImage un VÉRITABLE installeur.
#
#  Au premier lancement (double-clic sur Rufus.AppImage), propose d'« installer »
#  Rufus sur le poste : copie l'AppImage dans ~/.local/bin et crée un raccourci
#  dans le menu d'Ubuntu (fichier .desktop + icône), comme un setup.exe / .dmg.
#  Les lancements suivants (depuis le menu) démarrent directement l'application.
#
#  Désactivable en exportant RUFUS_NO_INSTALL=1.
# ─────────────────────────────────────────────────────────────────────────────
HERE="$(dirname "$(readlink -f "${0}")")"

# Bibliothèques + plugins Qt embarqués par linuxdeploy (usr/lib, usr/plugins).
export LD_LIBRARY_PATH="${HERE}/usr/lib:${LD_LIBRARY_PATH}"
export QT_PLUGIN_PATH="${HERE}/usr/plugins:${QT_PLUGIN_PATH}"
export QT_QPA_PLATFORM_PLUGIN_PATH="${HERE}/usr/plugins/platforms"

# ── Verrou anti-double-lancement ──────────────────────────────────────────────
# Pendant la phase d'install (apt via pkexec, parfois >30 s), faute de retour
# immédiat l'utilisateur peut double-cliquer → plusieurs instances. SingleApplication
# protège le binaire Qt, mais PAS cette phase AppRun (avant exec). On pose donc un
# verrou flock dès le départ ; le fd 9 est hérité par exec → le verrou tient toute la
# durée de Rufus, et un 2e lancement est refusé tant que Rufus tourne.
exec 9>"${HOME}/.rufus.applock" 2>/dev/null || true
if command -v flock >/dev/null 2>&1 && ! flock -n 9; then
    [ -n "${DISPLAY}${WAYLAND_DISPLAY}" ] && command -v zenity >/dev/null 2>&1 && \
        zenity --info --no-wrap --title="Rufus" \
        --text="Rufus est déjà en cours de lancement.\nMerci de patienter quelques instants." 2>/dev/null
    exit 0
fi

APPNAME="Rufus"
BIN="${HERE}/usr/bin/Rufus"                       # binaire réel dans l'AppDir
ICON_SRC="${HERE}/usr/share/icons/hicolor/256x256/apps/rufus.png"

APPS_DIR="${HOME}/.local/share/applications"
ICONS_DIR="${HOME}/.local/share/icons/hicolor/256x256/apps"
BIN_DIR="${HOME}/.local/bin"
DESKTOP="${APPS_DIR}/rufus.desktop"

# ── Pré-contrôle du socle MySQL (UNIQUEMENT en cas de MISE À JOUR) ────────────
#  Règle : MySQL >= 8.0.14, MariaDB exclu. On ne contrôle que si un Rufus PRÉEXISTE
#  (sinon, install neuve = rien à détruire = pas de contrôle). Trace ~/.rufus/.certif.
RUFUS_DIR="${HOME}/.rufus"
CERTIF="${RUFUS_DIR}/.certif"
INSTALLED_APPIMAGE="${BIN_DIR}/${APPNAME}.AppImage"

ecrit_certif() {
    mkdir -p "${RUFUS_DIR}" 2>/dev/null
    printf '%s | %s\n' "$(date '+%Y-%m-%d %H:%M')" "$1" >> "${CERTIF}" 2>/dev/null
}

# Y a-t-il une BASE Rufus À PROTÉGER sur ce poste ? On se fie UNIQUEMENT à rufus.ini
# (= poste réellement configuré / connecté à une base). PAS au raccourci menu ni à l'AppImage
# installée : ceux-ci signifient seulement « Rufus a déjà été lancé ici », pas « il y a une base ».
# Sinon un simple 2e lancement (après ajout au menu) déclencherait à tort le pré-contrôle MySQL.
rufus_preexistant() {
    [ -f "${HOME}/Documents/Rufus/rufus.ini" ]
}

# 0 = OK (>=8.0.14 MySQL) | 1 = trop vieux / MariaDB | 2 = pas de mysqld local
controle_mysql_local() {
    local out ver maj min pat
    out="$(mysqld --version 2>/dev/null)" || return 2
    [ -z "${out}" ] && return 2
    printf '%s' "${out}" | grep -qi mariadb && return 1
    ver="$(printf '%s' "${out}" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1)"
    [ -z "${ver}" ] && return 2
    maj="${ver%%.*}"; min="${ver#*.}"; min="${min%%.*}"; pat="${ver##*.}"
    [ "${maj}" -gt 8 ] && return 0
    [ "${maj}" -lt 8 ] && return 1
    [ "${min}" -gt 0 ] && return 0
    [ "${pat}" -ge 14 ] && return 0
    return 1
}

# 0 = on peut continuer ; 1 = on bloque (socle non garanti)
socle_mysql_ok() {
    [ -z "${DISPLAY}${WAYLAND_DISPLAY}" ] && return 0   # pas de GUI → on n'interroge pas

    controle_mysql_local; local e=$?

    if [ "${e}" -eq 0 ]; then ecrit_certif "MAJ - vérifié local : MySQL >= 8.0.14"; return 0; fi

    if [ "${e}" -eq 1 ]; then
        command -v zenity >/dev/null 2>&1 && zenity --error --no-wrap \
          --title="MySQL trop ancien" \
          --text="Cette version de Rufus exige MySQL 8.0.14 ou supérieur (MariaDB non pris en charge).\n\nVotre serveur MySQL local est trop ancien.\n\nAvant de mettre à jour : sauvegardez votre base (Rufus actuel) → mettez MySQL à jour vers 8.x → restaurez, puis relancez." 2>/dev/null
        ecrit_certif "REFUS (MAJ) : MySQL local < 8.0.14 ou MariaDB"
        return 1
    fi

    # e = 2 : pas de mysqld local → le Rufus existant est un CLIENT réseau → 2 boutons
    command -v zenity >/dev/null 2>&1 || { ecrit_certif "pas de mysqld local, zenity absent : laissé passer"; return 0; }
    if zenity --question --no-wrap --title="Vérification du serveur MySQL" \
        --text="Cette version de Rufus exige un serveur MySQL >= 8.0.14 (MariaDB non pris en charge).\n\nAucun MySQL local détecté (ce poste se connecte donc à un serveur réseau)." \
        --ok-label="Le serveur est en >= 8.0.14 (je certifie)" \
        --cancel-label="J'ignore la version — vérifier d'abord" 2>/dev/null; then
        ecrit_certif "CERTIFIÉ par l'utilisateur (MAJ) : serveur réseau >= 8.0.14"
        return 0
    fi
    zenity --info --no-wrap --title="Vérifiez votre serveur" \
        --text="Sur le SERVEUR, vérifiez la version de MySQL :\n  • mysqld --version\n  • ou, dans MySQL : SELECT VERSION();\nElle doit être >= 8.0.14 (et pas MariaDB).\n\nRelancez Rufus une fois la vérification faite." 2>/dev/null
    ecrit_certif "ABANDON (MAJ) : version serveur inconnue, vérification demandée"
    return 1
}

# On ne contrôle qu'en cas de MISE À JOUR : un Rufus préexiste ET on lance une
# AppImage AUTRE que celle déjà installée (= une nouvelle version qu'on démarre).
# Lancement normal depuis le menu (AppImage installée) → pas de contrôle, pas de
# question. Installation neuve (aucun Rufus préexistant) → pas de contrôle non plus.
if [ -n "${APPIMAGE}" ] && [ "${APPIMAGE}" != "${INSTALLED_APPIMAGE}" ] && rufus_preexistant; then
    socle_mysql_ok || exit 1
fi

# ── 1. Configuration système du poste (composants requis) ─────────────────────
#  Composants que l'AppImage ne peut PAS embarquer proprement : polices (dont les
#  MS core fonts), plugins GStreamer (lecture vidéo), client MySQL (sauvegarde/
#  restauration), et appartenance au groupe « dialout » (appareils de mesure sur
#  port série). Installés via UN seul pkexec (apt), à l'installation, avec
#  consentement.
#  Plus de marqueur « .systeme_ok » : tant que le poste n'est pas installé (pas de
#  .desktop), on rejoue toute la séquence. Si la config ÉCHOUE vraiment, on s'arrête
#  et on explique pourquoi ; la trace détaillée va dans ~/.rufus/install-systeme.log.
#  NB : libfuse2 (requis pour LANCER l'AppImage) ne peut pas s'auto-installer ici
#  (œuf/poule) → c'est un prérequis documenté sur la page de téléchargement.
#  Retour : 0 = OK (ou non applicable : pas de GUI / distribution non-apt) ; 1 = échec → on stoppe.
configurer_systeme() {
    [ -n "${RUFUS_NO_INSTALL}" ]          && return 0
    [ -z "${DISPLAY}${WAYLAND_DISPLAY}" ] && return 0   # pas d'affichage graphique
    command -v zenity  >/dev/null 2>&1    || return 0   # pas d'UI pour demander
    command -v apt-get >/dev/null 2>&1    || return 0   # distribution non-apt : on ne touche à rien

    zenity --question --no-wrap --title="Configurer Rufus sur ce poste" \
        --text="Rufus va installer quelques composants système nécessaires :\n  •  polices (affichage et impression des documents)\n  •  lecture des vidéos (GStreamer)\n  •  client MySQL (sauvegarde / restauration)\n  •  accès aux appareils de mesure sur port série\n\nLe mot de passe administrateur vous sera demandé." \
        --ok-label="Installer maintenant" --cancel-label="Annuler" 2>/dev/null || {
            zenity --error --no-wrap --title="Installation interrompue" \
                --text="La configuration du système a été annulée.\n\nRufus a besoin de ces composants pour fonctionner :\nrelancez l'installation quand vous serez prêt." 2>/dev/null
            return 1
        }

    local user; user="$(id -un)"
    local LOG="${RUFUS_DIR}/install-systeme.log"
    mkdir -p "${RUFUS_DIR}" 2>/dev/null

    if ! command -v pkexec >/dev/null 2>&1; then
        zenity --warning --no-wrap --title="Installation manuelle requise" \
            --text="pkexec est absent. Ouvrez un terminal et exécutez :\n\nsudo apt install gsfonts ttf-mscorefonts-installer gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly gstreamer1.0-libav gstreamer1.0-tools gstreamer1.0-x gstreamer1.0-alsa gstreamer1.0-gl gstreamer1.0-gtk3 gstreamer1.0-pulseaudio mysql-client\nsudo usermod -aG dialout ${user}\n\nPuis relancez Rufus." 2>/dev/null
        return 1
    fi

    # Un SEUL pkexec : EULA mscorefonts pré-acceptée, apt update, install PAQUET PAR
    # PAQUET (un paquet absent n'interrompt pas le reste), puis ajout au groupe dialout.
    # L'utilisateur réel est passé via env (pkexec s'exécute en root, $USER y vaudrait root).
    # DPkg::Lock::Timeout=300 : si unattended-upgrades tient le verrou apt (fréquent sur un
    # système fraîchement installé), apt patiente proprement jusqu'à 5 min au lieu de figer.
    # Le code de sortie porte le diagnostic : 10 = pas d'accès aux dépôts (réseau) ; pkexec
    # ajoute 126 (auth annulée) / 127 (non autorisé). La sortie complète est tee-ée dans LOG.
    # (NB : aucun commentaire à apostrophe DANS le bloc bash -c '...' — ça casserait la quote.)
    pkexec env DEBIAN_FRONTEND=noninteractive RUFUS_USER="${user}" bash -c '
        trap "" PIPE
        echo "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true" | debconf-set-selections 2>/dev/null
        rc=0
        if ! apt-get -o DPkg::Lock::Timeout=300 update -y; then
            echo "RUFUS_ERR: echec de apt-get update (acces reseau aux depots indisponible)"
            rc=10
        fi
        for p in gsfonts ttf-mscorefonts-installer \
                 gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
                 gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly \
                 gstreamer1.0-libav gstreamer1.0-tools gstreamer1.0-x \
                 gstreamer1.0-alsa gstreamer1.0-gl gstreamer1.0-gtk3 \
                 gstreamer1.0-pulseaudio mysql-client ; do
            apt-get -o DPkg::Lock::Timeout=300 install -y "$p" || echo "RUFUS_ERR: paquet non installe: $p"
        done
        usermod -aG dialout "$RUFUS_USER" || echo "RUFUS_ERR: ajout au groupe dialout impossible"
        exit $rc
    ' 2>&1 | tee "${LOG}" | sed -u 's/^/# /' | zenity --progress --pulsate --no-cancel --auto-close \
        --title="Installation des composants Rufus" \
        --text="Installation en cours… (cela peut prendre quelques minutes)" 2>/dev/null
    local rc=${PIPESTATUS[0]}

    if [ "${rc}" -eq 0 ]; then
        ecrit_certif "Config système OK (polices, GStreamer, mysql-client, dialout) pour ${user}"
        return 0
    fi

    # Échec réel : on explique (si on peut) et on stoppe l'installation.
    local raison
    case "${rc}" in
        126) raison="Authentification annulée (mot de passe administrateur non fourni)." ;;
        127) raison="Authentification refusée : ce compte n'est pas autorisé à installer des logiciels (droits administrateur/sudo requis)." ;;
        10)  raison="Impossible d'accéder aux dépôts de paquets. Vérifiez la connexion réseau, puis relancez." ;;
        *)   raison="Une erreur est survenue pendant l'installation des composants." ;;
    esac
    ecrit_certif "Config système ÉCHEC (rc=${rc}) : ${raison}"
    zenity --error --no-wrap --title="Configuration du système impossible" \
        --text="La configuration du système n'a pas pu se dérouler ; Rufus n'a pas été installé.\n\n${raison}\n\nDétails techniques : ${LOG}" 2>/dev/null
    return 1
}

# Inscription de Rufus dans les MENUS (copie de l'AppImage + icône + .desktop).
# Démarche standard d'un installeur : on inscrit, on ne le demande pas.
inscrire_dans_menus() {
    mkdir -p "${APPS_DIR}" "${ICONS_DIR}" "${BIN_DIR}"

    # 1. Copie de l'AppImage dans ~/.local/bin
    local cible="${BIN_DIR}/${APPNAME}.AppImage"
    cp -f "${APPIMAGE}" "${cible}"
    chmod +x "${cible}"

    # 2. Icône
    [ -f "${ICON_SRC}" ] && cp -f "${ICON_SRC}" "${ICONS_DIR}/rufus.png"

    # 3. Raccourci menu (.desktop) pointant sur l'AppImage installée
    cat > "${DESKTOP}" <<EOF
[Desktop Entry]
Type=Application
Name=${APPNAME}
Exec=${cible}
Icon=rufus
Comment=Logiciel de gestion de cabinet d'Ophtalmologie
Categories=Office;MedicalSoftware;
Terminal=false
EOF
    chmod +x "${DESKTOP}"

    # 4. Rafraîchissement des caches (best-effort, sans bloquer)
    command -v update-desktop-database >/dev/null 2>&1 && \
        update-desktop-database "${APPS_DIR}" >/dev/null 2>&1
    command -v gtk-update-icon-cache >/dev/null 2>&1 && \
        gtk-update-icon-cache -f -t "${HOME}/.local/share/icons/hicolor" >/dev/null 2>&1
}

# Raccourci sur le BUREAU (copie du .desktop, marqué « de confiance » pour GNOME).
creer_raccourci_bureau() {
    local desk
    desk="$(xdg-user-dir DESKTOP 2>/dev/null)"
    [ -z "${desk}" ] && { [ -d "${HOME}/Bureau" ] && desk="${HOME}/Bureau" || desk="${HOME}/Desktop"; }
    mkdir -p "${desk}" 2>/dev/null
    cp -f "${DESKTOP}" "${desk}/rufus.desktop" 2>/dev/null || return 0
    chmod +x "${desk}/rufus.desktop" 2>/dev/null
    # GNOME ≥ 3.36 grise le lanceur tant qu'il n'est pas marqué « trusted ».
    command -v gio >/dev/null 2>&1 && gio set "${desk}/rufus.desktop" metadata::trusted true 2>/dev/null
}

# Épingler Rufus dans la barre des FAVORIS (Activités GNOME) via gsettings.
ajouter_aux_favoris() {
    command -v gsettings >/dev/null 2>&1 || return 0
    local cur
    cur="$(gsettings get org.gnome.shell favorite-apps 2>/dev/null)" || return 0
    case "${cur}" in *"'rufus.desktop'"*) return 0 ;; esac   # déjà épinglé
    local nouv
    case "${cur}" in
        "@as []"|"[]") nouv="['rufus.desktop']" ;;
        *)             nouv="${cur%]*}, 'rufus.desktop']" ;;
    esac
    gsettings set org.gnome.shell favorite-apps "${nouv}" 2>/dev/null
}

# ── Centrage des fenêtres de l'installation (GNOME) ───────────────────────────
# zenity n'a aucune option de position : ses fenêtres se placent où le gestionnaire
# de fenêtres veut (souvent décentrées). La parade fiable et sans dépendance : activer
# le temps de l'install le réglage GNOME « center-new-windows », puis RENDRE à
# l'utilisateur son réglage d'origine. No-op hors GNOME/mutter (clé absente).
CENTRAGE_ANCIEN=""
CENTRAGE_MODIFIE=0
activer_centrage_fenetres() {
    command -v gsettings >/dev/null 2>&1 || return 0
    CENTRAGE_ANCIEN="$(gsettings get org.gnome.mutter center-new-windows 2>/dev/null)" || return 0
    [ -z "${CENTRAGE_ANCIEN}" ] && return 0          # clé absente → pas GNOME/mutter, on ne touche à rien
    [ "${CENTRAGE_ANCIEN}" = "true" ] && return 0    # déjà centré → rien à changer ni à restaurer
    gsettings set org.gnome.mutter center-new-windows true 2>/dev/null && CENTRAGE_MODIFIE=1
}
restaurer_centrage_fenetres() {
    [ "${CENTRAGE_MODIFIE}" = "1" ] || return 0
    gsettings set org.gnome.mutter center-new-windows "${CENTRAGE_ANCIEN}" 2>/dev/null
    CENTRAGE_MODIFIE=0
}

# Inscription dans les menus SOUS animation : la copie de l'AppImage (~60 Mo) et le
# rafraîchissement des caches prennent plusieurs secondes pendant lesquelles, sinon,
# rien ne s'affiche (le fameux « trou » entre l'install des composants et la fenêtre
# finale). On enveloppe donc l'opération dans une barre pulsante.
inscrire_dans_menus_avec_animation() {
    if command -v zenity >/dev/null 2>&1; then
        ( inscrire_dans_menus ) 2>&1 | zenity --progress --pulsate --no-cancel --auto-close \
            --title="Installation de Rufus" \
            --text="Finalisation : inscription de Rufus dans les menus…" 2>/dev/null
    else
        inscrire_dans_menus
    fi
}

# Boîte finale : annonce l'installation réussie et propose, par cases à cocher,
# le raccourci bureau (précoché), les favoris (précoché) et le lancement (décoché).
proposer_raccourcis_et_lancement() {
    command -v zenity >/dev/null 2>&1 || { restaurer_centrage_fenetres; return 0; }   # pas d'UI : on s'arrête là, sans lancer

    local sel
    sel="$(zenity --list --checklist \
        --title="Rufus est installé" --width=540 --height=300 \
        --text="Rufus a été correctement installé sur ce poste et dans les menus,\net le système a été configuré pour qu'il puisse fonctionner.\n\nQue souhaitez-vous faire ?" \
        --column="" --column="id" --column="Action" \
        --hide-column=2 --print-column=2 \
        TRUE  bureau  "Créer un raccourci sur le bureau" \
        TRUE  favoris "Inscrire dans la barre des favoris" \
        FALSE lancer  "Exécuter Rufus maintenant" \
        2>/dev/null)"

    case "${sel}" in *bureau*)  creer_raccourci_bureau ;; esac
    case "${sel}" in *favoris*) ajouter_aux_favoris    ;; esac
    restaurer_centrage_fenetres   #! rendre son réglage à l'utilisateur AVANT le exec (qui ne reviendrait jamais)
    case "${sel}" in *lancer*)  exec "${BIN}" "$@"     ;; esac   # remplace le process : Rufus démarre
}

# Faut-il (re)jouer la séquence d'installation ? Oui tant que le poste n'est pas
# installé (pas de .desktop), qu'on n'a pas explicitement désactivé l'install, et
# qu'on tourne bien depuis l'AppImage avec un affichage graphique.
integration_proposee() {
    [ -n "${RUFUS_NO_INSTALL}" ]          && return 1
    [ -f "${DESKTOP}" ]                   && return 1   # déjà installé
    [ -z "${DISPLAY}${WAYLAND_DISPLAY}" ] && return 1   # lancement en ligne de commande
    [ -z "${APPIMAGE}" ]                  && return 1   # posé par le runtime AppImage
    return 0
}

# ── Séquence d'INSTALLATION (1er lancement de l'AppImage, poste pas encore installé) ──
if integration_proposee; then
    # 0. Centrer toutes les fenêtres de l'install (réglage rendu à l'utilisateur à la fin).
    activer_centrage_fenetres
    # 1. Configurer le système. Si ça échoue réellement, on s'arrête là (rien d'inscrit).
    configurer_systeme || { restaurer_centrage_fenetres; exit 1; }
    # 2. Inscrire Rufus dans les menus (sous animation, pour ne pas laisser l'écran vide).
    inscrire_dans_menus_avec_animation
    # 3. Proposer raccourci bureau / favoris / lancement. Ne lance Rufus que si demandé.
    #    (restaure lui-même le centrage avant un éventuel exec.)
    proposer_raccourcis_et_lancement
    exit 0
fi

# ── Lancement NORMAL (poste déjà installé : démarrage depuis le menu) ──────────
exec "${BIN}" "$@"
