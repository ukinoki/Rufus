#!/bin/bash
# ─────────────────────────────────────────────────────────────────────────────
#  AppRun de l'AppImage Rufus — fait de l'AppImage un VÉRITABLE installeur.
#
#  Au premier lancement (double-clic sur Rufus.AppImage), propose d'« installer »
#  Rufus sur le poste : copie l'AppImage dans ~/.local/bin et crée un raccourci
#  dans le menu d'Ubuntu (fichier .desktop + icône), comme un setup.exe / .dmg.
#  Les lancements suivants (depuis le menu) démarrent directement l'application.
#
#  Désactivable en exportant RUFUS_NO_INSTALL=1.
# ─────────────────────────────────────────────────────────────────────────────
HERE="$(dirname "$(readlink -f "${0}")")"

# Libs et plugins Qt embarqués : posés sur le seul Rufus, car exportés ils tueraient les
# programmes système lancés ici (zenity, gsettings) en leur imposant les libs de l'AppImage.
# xcb imposé : le plugin wayland n'est pas embarqué, et Ubuntu pose QT_QPA_PLATFORM=wayland.
lancer_rufus() {
    exec env LD_LIBRARY_PATH="${HERE}/usr/lib" \
             QT_PLUGIN_PATH="${HERE}/usr/plugins" \
             QT_QPA_PLATFORM_PLUGIN_PATH="${HERE}/usr/plugins/platforms" \
             QT_QPA_PLATFORM=xcb \
             "${BIN}" "$@"
}

# ── Verrou anti-double-lancement ──────────────────────────────────────────────
# Pendant la phase d'install (apt via pkexec, parfois >30 s), faute de retour
# immédiat l'utilisateur peut double-cliquer → plusieurs instances. SingleApplication
# protège le binaire Qt, mais PAS cette phase AppRun (avant exec). On pose donc un
# verrou flock dès le départ ; le fd 9 est hérité par exec → le verrou tient toute la
# durée de Rufus, et un 2e lancement est refusé tant que Rufus tourne.
exec 9>"${HOME}/.rufus.applock" 2>/dev/null || true
if command -v flock >/dev/null 2>&1 && ! flock -n 9; then
    [ -n "${DISPLAY}${WAYLAND_DISPLAY}" ] && command -v zenity >/dev/null 2>&1 && \
        zenity --info --no-wrap --title="Rufus" \
        --text="Rufus est déjà en cours de lancement.\nMerci de patienter quelques instants." 2>/dev/null
    exit 0
fi

APPNAME="Rufus"
BIN="${HERE}/usr/bin/Rufus"                       # binaire réel dans l'AppDir
ICON_SRC="${HERE}/usr/share/icons/hicolor/256x256/apps/rufus.png"

APPS_DIR="${HOME}/.local/share/applications"
ICONS_DIR="${HOME}/.local/share/icons/hicolor/256x256/apps"
BIN_DIR="${HOME}/.local/bin"
DESKTOP="${APPS_DIR}/rufus.desktop"

# ── Pré-contrôle du socle MySQL ──────────────────────────────────────────────
#  LOGIQUE SIMPLIFIÉE (cf. « initialisation Rufus.txt », section I) : on regarde
#  seulement le MySQL LOCAL. Conforme (>=8.0.14) ou absent → on continue ; trop
#  ancien / MariaDB → avertissement + consentement (le message dit « si vous
#  n'hébergez pas la base ici, ignorez » → pas de détection de rôle).
#  Règle : MySQL >= 8.0.14, MariaDB exclu. Trace ~/.rufus/.certif.
RUFUS_DIR="${HOME}/.rufus"
CERTIF="${RUFUS_DIR}/.certif"
INSTALLED_APPIMAGE="${BIN_DIR}/${APPNAME}.AppImage"

ecrit_certif() {
    mkdir -p "${RUFUS_DIR}" 2>/dev/null
    printf '%s | %s\n' "$(date '+%Y-%m-%d %H:%M')" "$1" >> "${CERTIF}" 2>/dev/null
}

# Renseignées par controle_mysql_local (pour adapter le message) : version détectée et MariaDB ?
MYSQL_VER=""
MYSQL_IS_MARIA=0

# Version du SERVEUR MySQL EN COURS d'exécution, demandée AU serveur via le socket local
# (SELECT VERSION()). C'est la source de vérité : immunisée contre la version du CLIENT mysql
# — que Rufus installe lui-même depuis les dépôts (mysql-client 8.0.4x), souvent plus récent que
# le serveur en place — et contre les remous de paquets apt. Le socket évite toute résolution DNS.
# On essaie les mots de passe connus (~/.rufus/.dbkey, puis le legacy gaxt78iy).
# Écho : « 8.0.13 » / « 10.5.8-MariaDB »… ou rien si le serveur est injoignable / non authentifié.
version_serveur_en_cours() {
    command -v mysql >/dev/null 2>&1 || return 0
    local mdp out v
    local -a mdps=()
    if [ -f "${HOME}/.rufus/.dbkey" ]; then
        while IFS='=' read -r _ v; do [ -n "${v}" ] && mdps+=("${v}"); done < "${HOME}/.rufus/.dbkey"
    fi
    mdps+=("gaxt78iy")
    for mdp in "${mdps[@]}"; do
        out="$(mysql --protocol=socket --connect-timeout=5 -u adminrufus -p"${mdp}" -N -B -e "SELECT VERSION();" 2>/dev/null)" || continue
        out="$(printf '%s' "${out}" | grep -oiE '[0-9]+\.[0-9]+\.[0-9]+(-mariadb)?' | head -n1)"
        [ -n "${out}" ] && { printf '%s' "${out}"; return 0; }
    done
    return 0
}

# 0 = OK (>=8.0.14 MySQL) | 1 = trop vieux / MariaDB | 2 = pas de mysqld local
controle_mysql_local() {
    local out maj min pat sv mysqld_bin
    MYSQL_VER=""; MYSQL_IS_MARIA=0

    # 1. Source de vérité : la version annoncée par le SERVEUR en cours (cf. version_serveur_en_cours).
    sv="$(version_serveur_en_cours)"
    if [ -n "${sv}" ]; then
        out="${sv}"
    else
        # 2. Repli : binaire serveur mysqld. On le cherche aussi HORS PATH (/usr/sbin : mysqld n'y est
        #    pas pour un utilisateur normal, ni au lancement GUI par double-clic).
        mysqld_bin="$(command -v mysqld 2>/dev/null || true)"
        [ -z "${mysqld_bin}" ] && [ -x /usr/sbin/mysqld ]            && mysqld_bin=/usr/sbin/mysqld
        [ -z "${mysqld_bin}" ] && [ -x /usr/local/mysql/bin/mysqld ] && mysqld_bin=/usr/local/mysql/bin/mysqld
        [ -z "${mysqld_bin}" ] && return 2
        out="$("${mysqld_bin}" --version 2>/dev/null)" || return 2
        [ -z "${out}" ] && return 2
    fi
    if printf '%s' "${out}" | grep -qi mariadb; then MYSQL_IS_MARIA=1; return 1; fi
    MYSQL_VER="$(printf '%s' "${out}" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1)"
    [ -z "${MYSQL_VER}" ] && return 2
    maj="${MYSQL_VER%%.*}"; min="${MYSQL_VER#*.}"; min="${min%%.*}"; pat="${MYSQL_VER##*.}"
    [ "${maj}" -gt 8 ] && return 0
    [ "${maj}" -lt 8 ] && return 1
    [ "${min}" -gt 0 ] && return 0
    [ "${pat}" -ge 14 ] && return 0
    return 1
}

# 0 = on peut continuer ; 1 = on bloque (l'utilisateur a refusé)
socle_mysql_ok() {
    [ -z "${DISPLAY}${WAYLAND_DISPLAY}" ] && return 0   # pas de GUI → on n'interroge pas

    controle_mysql_local; local e=$?

    # Conforme (0) ou pas de MySQL local (2) → rien à signaler → on continue.
    if [ "${e}" -ne 1 ]; then
        ecrit_certif "MySQL local conforme ou absent (e=${e}) : poursuite sans avertissement"
        return 0
    fi

    # e = 1 : MySQL local présent mais trop ancien (ou MariaDB) → avertissement + consentement.
    command -v zenity >/dev/null 2>&1 || { ecrit_certif "MySQL ancien/MariaDB mais zenity absent : laissé passer"; return 0; }

    # Détail adapté à la situation réelle : MariaDB (incompatible) vs MySQL trop ancien.
    local detail
    if [ "${MYSQL_IS_MARIA}" = "1" ]; then
        detail="${MSG_MYSQL_MARIA}"
    else
        detail="${MSG_MYSQL_OLD//%VER%/${MYSQL_VER}}"
    fi

    local reponse=0
    zenity --question --no-wrap --title="${MSG_MYSQL_TITLE}" \
        --text="${MSG_MYSQL_BODY//%DETAIL%/${detail}}" \
        --ok-label="${MSG_MYSQL_OK}" --cancel-label="${MSG_CFG_CANCEL}" 2>/dev/null || reponse=1

    if [ "${reponse}" = 0 ]; then
        ecrit_certif "Avertissement MySQL ancien/MariaDB accepté : poursuite"
        return 0
    fi
    ecrit_certif "Avertissement MySQL ancien/MariaDB : installation annulée par l'utilisateur"
    return 1
}

# Liste UNIQUE des paquets requis (référencée par la détection de présence, le bloc
# pkexec et le message d'installation manuelle — un seul endroit à maintenir).
# pcscd + libccid : lecture DIRECTE de la carte Vitale (PC/SC). Absents par défaut sous Ubuntu ;
# pcscd s'active à la demande (socket) après installation, aucun réglage supplémentaire. libpcsclite,
# contre laquelle Rufus est lié, est embarquée dans l'AppImage — ici on pose le démon + le pilote USB.
PAQUETS_REQUIS="gsfonts ttf-mscorefonts-installer \
gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-plugins-bad \
gstreamer1.0-plugins-ugly gstreamer1.0-libav gstreamer1.0-tools gstreamer1.0-x \
gstreamer1.0-alsa gstreamer1.0-gl gstreamer1.0-gtk3 gstreamer1.0-pulseaudio \
pcscd libccid cifs-utils"

# Client MySQL (sauvegarde / restauration) : ajouté UNIQUEMENT si aucun client mysql n'est déjà
# présent. Installer celui des dépôts Ubuntu PAR-DESSUS un client d'un autre éditeur (p.ex. un
# MySQL Oracle pré-installé) provoque une collision de paquets (mysql-common / clients de versions
# différentes) qui casse l'état dpkg et bloque tout apt ultérieur. Et c'est sans intérêt : tout
# client 8.0.x dialogue avec tout serveur 8.0.x, donc le client déjà en place fait l'affaire.
command -v mysql >/dev/null 2>&1 || PAQUETS_REQUIS="${PAQUETS_REQUIS} mysql-client"

# Tous les composants sont-ils DÉJÀ en place ? (paquets installés + appartenance à
# dialout). Si oui, en cas de MAJ / réinstallation, inutile de reproposer l'install.
composants_systeme_presents() {
    command -v dpkg-query >/dev/null 2>&1 || return 1
    local p
    for p in ${PAQUETS_REQUIS}; do
        [ "$(dpkg-query -W -f='${db:Status-Status}' "$p" 2>/dev/null)" = "installed" ] || return 1
    done
    # id -nG <user> interroge la base de groupes (état réel), pas seulement la session courante.
    id -nG "$(id -un)" 2>/dev/null | tr ' ' '\n' | grep -qx dialout || return 1
    return 0
}

# Combien de composants requis manquent (paquets absents + éventuellement le groupe dialout) ?
# Sert à adapter le message : « un composant manque » (court) vs « installer tous les composants ».
nb_composants_manquants() {
    local n=0 p
    if command -v dpkg-query >/dev/null 2>&1; then
        for p in ${PAQUETS_REQUIS}; do
            [ "$(dpkg-query -W -f='${db:Status-Status}' "$p" 2>/dev/null)" = "installed" ] || n=$((n+1))
        done
    fi
    id -nG "$(id -un)" 2>/dev/null | tr ' ' '\n' | grep -qx dialout || n=$((n+1))
    echo "${n}"
}

# ── Choix de la langue de l'installation (1re fenêtre) ────────────────────────
# Présélection : 1) langue du POSTE si Rufus.ini existe (clé [Param_Poste] Version,
# cohérent avec les preinstallers macOS/Windows) ; 2) sinon locale du système ;
# 3) repli FR (>90 % d'utilisateurs francophones). La présélection reste modifiable.
LANG_INSTALL="fr"
choisir_langue_install() {
    command -v zenity >/dev/null 2>&1 || { LANG_INSTALL="fr"; return 0; }

    local pref=""
    # 1) Rufus.ini du poste. On essaie les deux casses (Linux est sensible à la casse ;
    #    la macro pose « Rufus.ini », mais d'anciens fichiers peuvent être en minuscules).
    local ini=""
    local cand
    for cand in "${HOME}/Documents/Rufus/Rufus.ini" "${HOME}/Documents/Rufus/rufus.ini"; do
        [ -f "${cand}" ] && { ini="${cand}"; break; }
    done
    if [ -n "${ini}" ]; then
        # Valeur de Version DANS la section [Param_Poste] uniquement.
        case "$(awk '
            /^\[/ { insec = ($0 ~ /^\[Param_Poste\]/) }
            insec && /^[Vv]ersion[ \t]*=/ { sub(/^[^=]*=[ \t]*/, ""); gsub(/[ \t\r]/, ""); print toupper($0); exit }
        ' "${ini}" 2>/dev/null)" in
            EN)    pref=en ;;
            ES)    pref=es ;;
            PT|BR) pref=pt ;;   # br -> pt (comme les preinstallers macOS/Windows)
            IT)    pref=it ;;
            RO)    pref=ro ;;
            FR)    pref=fr ;;
        esac
    fi
    # 2) à défaut, la locale du système.
    [ -z "${pref}" ] && case "${LANG%%_*}" in
        en) pref=en ;; es) pref=es ;; pt) pref=pt ;; it) pref=it ;; ro) pref=ro ;; *) pref=fr ;;
    esac

    local fr=FALSE en=FALSE es=FALSE pt=FALSE it=FALSE ro=FALSE
    case "${pref}" in
        en) en=TRUE ;; es) es=TRUE ;; pt) pt=TRUE ;; it) it=TRUE ;; ro) ro=TRUE ;; *) fr=TRUE ;;
    esac
    local choix
    # Hauteur imposée : sous 24.04 la liste tronque les langues sans rien qui le signale.
    choix="$(zenity --list --radiolist --hide-header --title="Rufus — langue / language" \
        --height=380 \
        --text="Choisissez la langue de l'installation / Choose the installation language:" \
        --column="" --column="Langue" \
        "${fr}" "Français" "${en}" "English" "${es}" "Español" "${pt}" "Português" \
        "${it}" "Italiano" "${ro}" "Română" \
        2>/dev/null)"
    case "${choix}" in
        English)    LANG_INSTALL="en" ;;
        Español)    LANG_INSTALL="es" ;;
        Português)  LANG_INSTALL="pt" ;;
        Italiano)   LANG_INSTALL="it" ;;
        Română)     LANG_INSTALL="ro" ;;
        *)          LANG_INSTALL="fr" ;;   # Français, ou fenêtre fermée
    esac
}

