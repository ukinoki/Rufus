#!/bin/bash
# ─────────────────────────────────────────────────────────────────────────────
#  preinstall du .pkg Rufus — PRÉ-CONTRÔLE du socle MySQL, AVANT toute copie.
#  Un exit ≠ 0 annule l'installation → l'ancien Rufus n'est PAS remplacé.
#
#  LOGIQUE SIMPLIFIÉE (cf. « initialisation Rufus.txt », section I) : on NE devine
#  PLUS le rôle du poste (serveur/client) à partir de rufus.ini. On regarde
#  seulement s'il y a un serveur MySQL LOCAL et, le cas échéant, sa version :
#    • pas de MySQL local      → rien à signaler (MySQL sera posé au 1er lancement) → on installe ;
#    • MySQL local >= 8.0.14    → conforme → on installe ;
#    • MySQL local < 8.0.14 / MariaDB → message d'avertissement (le 1er lancement
#      proposera une mise à jour qui efface les données → sauvegarde). Le message
#      dit explicitement « si vous n'hébergez pas la base ici, ignorez » : plus
#      besoin de détecter le rôle. Annuler → on stoppe ; OK → on installe.
#
#  Règle de version : MySQL >= 8.0.14, MariaDB exclu.
#  Particularité macOS : le script tourne en root dans le contexte de l'installeur
#  (sans session graphique). On affiche les dialogues dans la session de
#  l'utilisateur connecté via « launchctl asuser … osascript ».
# ─────────────────────────────────────────────────────────────────────────────
MIN_MAJOR=8; MIN_MINOR=0; MIN_PATCH=14

CONSOLE_UID="$(stat -f%Su /dev/console 2>/dev/null)"
CONSOLE_HOME="$(eval echo "~${CONSOLE_UID}" 2>/dev/null)"
# rufus.ini de l'utilisateur CONNECTÉ : sert UNIQUEMENT à choisir la langue du message.
RUFUS_INI="${CONSOLE_HOME}/Documents/Rufus/Rufus.ini"

ecrit_certif() {
    local dir="${CONSOLE_HOME}/.rufus"
    mkdir -p "${dir}" 2>/dev/null
    printf '%s | %s\n' "$(date '+%Y-%m-%d %H:%M')" "$1" >> "${dir}/.certif" 2>/dev/null
    chown -R "${CONSOLE_UID}" "${dir}" 2>/dev/null
}

# 0 = OK (>=8.0.14 MySQL) | 1 = trop vieux / MariaDB | 2 = pas de mysqld local
controle_mysql_local() {
    local bin="" c out ver maj min pat
    for c in mysqld /usr/local/mysql/bin/mysqld; do
        if command -v "$c" >/dev/null 2>&1; then bin="$c"; break; fi
        if [ -x "$c" ]; then bin="$c"; break; fi
    done
    [ -z "${bin}" ] && return 2
    out="$("${bin}" --version 2>/dev/null)" || return 2
    [ -z "${out}" ] && return 2
    printf '%s' "${out}" | grep -qi mariadb && return 1
    ver="$(printf '%s' "${out}" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1)"
    [ -z "${ver}" ] && return 2
    maj="${ver%%.*}"; min="${ver#*.}"; min="${min%%.*}"; pat="${ver##*.}"
    [ "${maj}" -gt "${MIN_MAJOR}" ] && return 0
    [ "${maj}" -lt "${MIN_MAJOR}" ] && return 1
    [ "${min}" -gt "${MIN_MINOR}" ] && return 0
    [ "${min}" -lt "${MIN_MINOR}" ] && return 1
    [ "${pat}" -ge "${MIN_PATCH}" ] && return 0
    return 1
}

# Langue du message, d'après rufus.ini ([Param_Poste] Version, = Param_Poste_Version
# côté code). Traduit : fr, en, es, pt (br -> pt) ; repli fr pour toute autre / si absent.
langue_depuis_ini() {
    local v
    v="$(awk '
        /^\[/ { in_s = ($0 == "[Param_Poste]") }
        in_s && tolower($0) ~ /^version[ \t]*=/ {
            sub(/^[^=]*=[ \t]*/, ""); gsub(/[ \t\r]/, ""); print tolower($0); exit
        }
    ' "${RUFUS_INI}" 2>/dev/null)"
    case "$v" in
        fr|en|es|pt) echo "$v" ;;
        br)          echo "pt" ;;
        *)           echo "fr" ;;
    esac
}

# Textes localisés du message d'avertissement (titre, corps, bouton Annuler, bouton OK).
definir_textes_consentement() {
    case "$1" in
      en)
        C_TITLE="MySQL server to update"
        C_TEXT="IMPORTANT

Rufus stores your patient data in a database — on this computer, on another computer of your network, or on a remote server. That database is managed by the MySQL server, required by Rufus, which Rufus installs itself on first launch.

If you do not intend to host the patient database on this computer, ignore this message.

This version of Rufus greatly strengthens password security and requires a MySQL server >= 8.0.14 (MariaDB not supported). This computer already hosts a MySQL/MariaDB server that is too old or incompatible.

On first launch, Rufus will offer to update the server. This update erases the data and therefore requires a backup:
• if the database on this computer is a Rufus patient database, Rufus can back it up and restore it automatically;
• if it holds other data, back it up yourself, otherwise it will be permanently lost.

Do you want to continue installing Rufus?"
        C_CANCEL="Cancel, I will do this later"
        C_OK="OK, continue" ;;
      es)
        C_TITLE="Servidor MySQL por actualizar"
        C_TEXT="IMPORTANTE

Rufus almacena los datos de sus pacientes en una base de datos: en este equipo, en otro equipo de su red o en un servidor remoto. Esa base la gestiona el servidor MySQL, imprescindible para Rufus, que Rufus instala por sí mismo en el primer arranque.

Si no piensa alojar la base de pacientes en este equipo, ignore este mensaje.

Esta versión de Rufus refuerza enormemente la seguridad de las contraseñas y requiere un servidor MySQL >= 8.0.14 (MariaDB no compatible). Este equipo ya aloja un servidor MySQL/MariaDB demasiado antiguo o incompatible.

En el primer arranque, Rufus propondrá actualizar el servidor. Esta actualización borra los datos y por tanto exige una copia de seguridad:
• si la base de este equipo es una base de pacientes Rufus, Rufus podrá copiarla y restaurarla automáticamente;
• si contiene otros datos, haga usted mismo una copia, de lo contrario se perderán definitivamente.

¿Desea continuar la instalación de Rufus?"
        C_CANCEL="Cancelar, lo haré más tarde"
        C_OK="Aceptar, continuar" ;;
      pt)
        C_TITLE="Servidor MySQL a atualizar"
        C_TEXT="IMPORTANTE

O Rufus guarda os dados dos seus pacientes numa base de dados — neste computador, noutro computador da sua rede ou num servidor remoto. Essa base é gerida pelo servidor MySQL, indispensável ao Rufus, que o Rufus instala por si próprio no primeiro arranque.

Se não tenciona alojar a base de pacientes neste computador, ignore esta mensagem.

Esta versão do Rufus reforça muito a segurança das palavras-passe e exige um servidor MySQL >= 8.0.14 (MariaDB não suportado). Este computador já aloja um servidor MySQL/MariaDB demasiado antigo ou incompatível.

No primeiro arranque, o Rufus proporá atualizar o servidor. Esta atualização apaga os dados e exige portanto uma cópia de segurança:
• se a base deste computador for uma base de pacientes Rufus, o Rufus poderá copiá-la e restaurá-la automaticamente;
• se contiver outros dados, faça você mesmo uma cópia, caso contrário serão definitivamente perdidos.

Deseja continuar a instalação do Rufus?"
        C_CANCEL="Cancelar, farei isto mais tarde"
        C_OK="OK, continuar" ;;
      *)
        C_TITLE="Serveur MySQL à mettre à jour"
        C_TEXT="IMPORTANT

Rufus stocke les données de vos patients dans une base de données — sur ce poste, sur un autre poste de votre réseau, ou sur un serveur distant. Cette base est gérée par le serveur MySQL, indispensable à Rufus, que Rufus installe lui-même à son premier lancement.

Si vous ne comptez pas héberger la base patients sur ce poste, ignorez ce message.

Cette version de Rufus renforce fortement la sécurité des mots de passe et nécessite un serveur MySQL >= 8.0.14 (MariaDB non pris en charge). Or ce poste héberge déjà un serveur MySQL/MariaDB trop ancien ou incompatible.

À son premier lancement, Rufus proposera de mettre à jour le serveur. Cette mise à jour efface les données et nécessite donc une sauvegarde :
• si la base de ce poste est une base patients Rufus, Rufus pourra la sauvegarder puis la restaurer automatiquement ;
• si elle contient d'autres données, sauvegardez-les vous-même, sinon elles seront définitivement perdues.

Voulez-vous continuer à installer Rufus ?"
        C_CANCEL="Annuler, je ferai cela plus tard"
        C_OK="OK, continuer" ;;
    esac
}

# Avertissement « serveur MySQL à mettre à jour », dans la langue du poste. Renvoie 0 si
# l'utilisateur accepte (clic OK), 1 sinon. Le texte est passé en ARGUMENTS à osascript
# (on run argv) : aucune contrainte d'apostrophe, l'échappement est géré par le shell.
dialogue_consentement_maj() {
    definir_textes_consentement "$(langue_depuis_ini)"
    local choix
    choix="$(launchctl asuser "$(id -u "${CONSOLE_UID}" 2>/dev/null)" \
        osascript - "${C_TEXT}" "${C_TITLE}" "${C_CANCEL}" "${C_OK}" 2>/dev/null <<'APPLESCRIPT'
on run argv
    try
        set b to button returned of (display dialog (item 1 of argv) buttons {item 3 of argv, item 4 of argv} default button 2 with title (item 2 of argv) with icon caution)
        return b
    on error
        return "CANCEL"
    end try
end run
APPLESCRIPT
)"
    [ "${choix}" = "${C_OK}" ]
}

# ── Contrôle ────────────────────────────────────────────────────────────────
controle_mysql_local; ETAT=$?

# Pas de MySQL local (ETAT=2) ou MySQL local conforme (ETAT=0) → rien à signaler → on installe.
if [ "${ETAT}" -ne 1 ]; then
    ecrit_certif "MySQL local conforme ou absent (ETAT=${ETAT}) : installation sans avertissement"
    exit 0
fi

# ETAT=1 : MySQL local présent mais trop ancien (ou MariaDB) → avertissement + consentement.
#   OK      → exit 0 : l'install se fait ; au 1er lancement, si ce poste héberge la base, Rufus
#             proposera la mise à jour du socle (sauvegarde validée → réinstall → restauration).
#   Annuler → exit 1 : l'installeur stoppe, l'ancien Rufus reste en place.
if dialogue_consentement_maj; then
    ecrit_certif "Avertissement MySQL ancien/MariaDB accepté : installation poursuivie"
    exit 0
fi
ecrit_certif "Avertissement MySQL ancien/MariaDB : installation annulée par l'utilisateur"
exit 1
